{
  "name": "prestamos-uao-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run backend\" \"npm run frontend\"",
    "backend": "npm run dev --workspace backend",
    "frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "db:init": "node database/init.js",
    "health:check": "node scripts/check-health.mjs",
    "db:admin": "node scripts/make-admin.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
