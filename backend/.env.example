PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=prestamos_uao_web
FRONTEND_ORIGIN=http://localhost:5173
# Genera un valor aleatorio de al menos 32 caracteres en backend/.env.
SESSION_SECRET=
SESSION_COOKIE_NAME=prestamos.sid
NODE_ENV=development
# Carpeta de archivos subidos (fuera de carpetas públicas). Relativa a backend/ o absoluta.
# Vacío = backend/storage. En producción: ruta de un volumen persistente.
FILE_STORAGE_DIR=
# Tamaño máximo por archivo en bytes (vacío = 10485760, 10 MiB).
FILE_MAX_BYTES=
